GCP_PROJECT_ID=your-project-id
# Gemini 3.x is served from the global Vertex endpoint, not a region.
GCP_LOCATION=global
GCS_BUCKET_NAME=your-media-bucket

GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GEMINI_MODEL=gemini-3.6-flash

# false trusts X-Caregiver-Id / X-Elder-Id headers: local development only.
AUTH_ENABLED=false
DEV_CAREGIVER_ID=dev-caregiver

# Shared secret Cloud Scheduler sends to the worker endpoint.
WORKER_TOKEN=local-worker-token

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
