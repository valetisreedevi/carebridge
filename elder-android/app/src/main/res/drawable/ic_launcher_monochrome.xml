<?xml version="1.0" encoding="utf-8"?>
<!-- The themed-icon layer, required from Android 13. Without a <monochrome>
     entry the system does not fall back to the coloured icon — it draws the app
     as a featureless blob in the wallpaper's accent colour, which on a phone
     with themed icons switched on is what the family would have been tapping.

     Same geometry as ic_launcher_foreground.xml. The colour here is discarded;
     Android keeps only the alpha and tints it to the wallpaper. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:scaleX="1.08"
        android:scaleY="1.08"
        android:translateX="20.52"
        android:translateY="19.98">

        <!-- The elder: head, and shoulders opening to the left. -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M11,19 a8,8 0 1,0 16,0 a8,8 0 1,0 -16,0 Z" />
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="6"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M10,49 V37 a9.5,9.5 0 0 1 9.5,-9.5" />

        <!-- The reach. This one stroke is the bridge the product is named for. -->
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="5.5"
            android:strokeLineCap="round"
            android:pathData="M19,31 c9,0 17,3 22,8" />

        <!-- The family member, smaller and set back. -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M37.5,26 a6.5,6.5 0 1,0 13,0 a6.5,6.5 0 1,0 -13,0 Z" />
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="6"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M36,49 v-7 a8,8 0 0 1 16,0 v7" />
    </group>
</vector>
