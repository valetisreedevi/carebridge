<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Lets the reminder take over the screen when the phone is locked, which
         is the whole point: the elder should not have to open an app.
         Since Android 14 declaring this is not enough — it is only granted on
         install to clocks and diallers, and anything else has to send the user
         to Settings to turn it on. MainActivity does that during pairing. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- Doze can hold a reminder back until the phone next wakes, which for a
         sleeping elder is the morning. Asked for once, during setup. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Oppo/OnePlus (ColorOS) and several other skins refuse to let an app
         raise a screen from the background unless it also holds this. Stock
         Android does not need it for a full-screen intent; those phones do,
         and they are silent about refusing. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Without this, package visibility on targetSdk 35 makes
         SpeechRecognizer.isRecognitionAvailable() return false and the
         microphone button silently disappears. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".CareBridgeApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.CareBridge">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Started by the full-screen intent on a reminder notification. -->
        <activity
            android:name=".ui.ReminderActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true" />

        <service
            android:name=".notify.CareBridgeMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="carebridge_reminders" />

    </application>
</manifest>
