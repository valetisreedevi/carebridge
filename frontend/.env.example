# Where the API lives. Omit to use http://localhost:8000.
VITE_API_URL=http://127.0.0.1:8000

# Caregiver sign-in. Leave these out and the app skips sign-in entirely,
# identifying the caregiver by header instead — local development only, and
# only valid against an API running with AUTH_ENABLED=false.
# See infrastructure/FIREBASE_SETUP.md for where these come from.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=
