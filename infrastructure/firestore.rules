rules_version = '2';

// CareBridge clients never talk to Firestore directly - every read and write
// goes through the API, which enforces ownership and the event state machine.
// These rules exist so that a leaked config cannot become a data breach.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
